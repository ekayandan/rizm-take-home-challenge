{
  "name": "hall-hvac-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "seed": "tsx --experimental-sqlite --disable-warning=ExperimentalWarning server/src/seed.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false --experimental-sqlite --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.app.json",
    "test": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning --test server/checker/checker.test.ts server/test/*.test.ts"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.22",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.1.0"
  }
}
